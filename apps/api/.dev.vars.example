APP_ENV=development
DEV_OWNER_ID=00000000-0000-4000-8000-000000000001
# HYPERDRIVE is intentionally absent. It is a Wrangler binding configured
# in wrangler.jsonc, not a development variable. Wrangler reads this file
# as plain text, so a binding cannot be reproduced here: the JSON form
# ("HYPERDRIVE={\"connectionString\":...}") reaches the Worker as a
# string, is not a connection string, and the database connection hangs.
# For local Wrangler development, set the documented Hyperdrive connection
# variable in the current PowerShell session instead:
#   CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
# Its value must come from your approved local secret source and must never
# be committed or pasted into this example file.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=artisan-marketplace-media

# Optional: Use a real AI provider locally (requires valid OpenAI key).
# When set, the local development environment will use the real provider
# instead of the deterministic fixture. This is useful for end-to-end testing
# of the AI pipeline with real model output.
# OPENAI_API_KEY=sk-...
# AI_PROVIDER_MODEL=gpt-4o-mini
# AI_PROVIDER_VERSION=2024-07-18
