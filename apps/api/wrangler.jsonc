{
  "name": "artisan-marketplace-api",
  // The Worker entry is the worker-only shell around the shared app in
  // `src/index.ts`. It carries the build-time precompiled WebAssembly
  // imports (Cloudflare forbids runtime wasm code generation); the app
  // itself stays importable from the Node test suite.
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-18",
  // node-postgres reaches PostgreSQL over Node's TCP and TLS built-ins,
  // so the PostgreSQL repositories cannot connect without this flag.
  "compatibility_flags": ["nodejs_compat"],
  // The Worker reaches PostgreSQL only through a Hyperdrive binding. A
  // deployed Worker receives the real Hyperdrive configuration; `wrangler
  // dev` has no Hyperdrive configuration to resolve, so it connects
  // directly to `localConnectionString` instead. Both shapes deliver the
  // same binding object to the Worker, so there is one local and one
  // production code path and no development-only database setting.
  //
  // The `id` is the placeholder configuration id and must be replaced
  // with the deployed Hyperdrive configuration id before any deploy.
  // The local connection string is a project-local development value
  // that mirrors infra/docker/local-compose.yml; it is not a production
  // credential and is never used outside `wrangler dev`.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString":
        "postgresql://artisan_marketplace:artisan_marketplace_dev@127.0.0.1:55432/artisan_marketplace_dev"
    }
  ],
  "workers_dev": true
}
